<!-- Button -->
<button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#mandiModal">
  📈 Mandi Bhav
</button>

<!-- Popup -->
<div class="modal fade" id="mandiModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">📈 Today Mandi rate</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <p class="text-muted small mb-3">
                   Source: Agmarknet (Ministry of Agriculture & Farmers Welfare, Govt. of India) via data.gov.in.
          Wholesale price, in ₹ per kg. The retail price is slightly higher than this.
        </p>

        <form id="mmForm" class="row g-2 mb-3">
          <div class="col-md-4">
            <input id="mmCrop" class="form-control" list="mmCrops" maxlength="40"
              placeholder="Crop (Like Tomato)" required>
            <datalist id="mmCrops">
              <% ['Tomato','Potato','Onion','Brinjal','Cabbage','Cauliflower','Carrot','Garlic','Green Chilli','Banana','Apple','Mango','Wheat','Rice','Maize','Bajra','Jowar','Gram','Mustard','Soyabean','Groundnut'].forEach(c => { %>
                <option value="<%= c %>">
              <% }) %>
            </datalist>
          </div>
          <div class="col-md-4">
            <select id="mmState" class="form-select">
              <option value="">All India</option>
              <% ['Andhra Pradesh','Assam','Bihar','Chandigarh','Chhattisgarh','NCT of Delhi','Goa','Gujarat','Haryana','Himachal Pradesh','Jammu and Kashmir','Jharkhand','Karnataka','Kerala','Madhya Pradesh','Maharashtra','Odisha','Punjab','Rajasthan','Tamil Nadu','Telangana','Uttar Pradesh','Uttarakhand','West Bengal'].forEach(s => { %>
                <option value="<%= s %>"><%= s %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <input id="mmDistrict" class="form-control" maxlength="40" placeholder="District">
          </div>
          <div class="col-md-2 d-grid">
            <button class="btn btn-success" id="mmGo">See</button>
          </div>
        </form>

        <div id="mmOut"></div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const form = document.getElementById('mmForm');
    const out = document.getElementById('mmOut');
    const stateSel = document.getElementById('mmState');
    const cropEl = document.getElementById('mmCrop');
    const go = document.getElementById('mmGo');

    // pichhla chuna hua rajya yaad rakho
    try { const s = localStorage.getItem('mandiState'); if (s) stateSel.value = s; } catch (e) { }

    // popup khulte hi fasal wale box par cursor
    document.getElementById('mandiModal').addEventListener('shown.bs.modal', () => cropEl.focus());

    const el = (tag, cls, text) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text !== undefined) e.textContent = text;
      return e;
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      try { localStorage.setItem('mandiState', stateSel.value); } catch (e) { }

      go.disabled = true;
      out.replaceChildren(el('div', 'text-muted', 'Searching Rate...'));

      const q = new URLSearchParams({
        commodity: cropEl.value,
        state: stateSel.value,
        district: document.getElementById('mmDistrict').value
      });

      try {
        const r = await fetch('/mandi/api?' + q);
        const d = await r.json();

        if (!r.ok) {
          out.replaceChildren(el('div', 'alert alert-danger mb-0', d.error || 'Error .'));
        } else if (!d.found) {
          out.replaceChildren(el('div', 'alert alert-warning mb-0',
            'This crop did not fetch a good price. Try writing the name in English, or remove the district name and see..'));
        } else {
          const box = el('div');

          const card = el('div', 'p-3 mb-3 rounded bg-light border');
          card.appendChild(el('div', 'fw-semibold', d.commodity + ' · ' + d.date));
          card.appendChild(el('div', 'fs-4 text-success fw-semibold',
            '₹' + d.summary.low + ' – ₹' + d.summary.high + ' / kg'));
          card.appendChild(el('div', 'text-muted small',
            'Average (modal): ₹' + d.summary.avg + '/kg · ' + d.summary.markets + ' mandi'));
          box.appendChild(card);

          const tw = el('div', 'table-responsive');
          const t = el('table', 'table table-sm align-middle mb-0');
          const head = el('thead');
          const hr = el('tr');
          ['Mandi', 'District', 'Min', 'Modal', 'Max'].forEach((h) => hr.appendChild(el('th', '', h)));
          head.appendChild(hr);
          t.appendChild(head);

          const body = el('tbody');
          d.rows.slice(0, 15).forEach((x) => {
            const tr = el('tr');
            [x.market, x.district, '₹' + (x.min ?? '-'), '₹' + x.modal, '₹' + (x.max ?? '-')]
              .forEach((c) => tr.appendChild(el('td', '', c || '-')));
            body.appendChild(tr);
          });
          t.appendChild(body);
          tw.appendChild(t);
          box.appendChild(tw);

          if (d.rows.length > 15) {
            box.appendChild(el('div', 'text-muted small mt-2', 'We are showing the 15 cheapest mandis (markets).'));
          }
          out.replaceChildren(box);
        }
      } catch (e) {
        out.replaceChildren(el('div', 'alert alert-danger mb-0', 'Network error. try Again.'));
      }
      go.disabled = false;
    });
  })();
</script>