<% layout('/layouts/boilerplate') %>

<% const hasFilter = filters.q || filters.category || filters.maxPrice || filters.sort !== 'new'; %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Fresh Crops, Direct from Farmers</h3>
  <div class="d-flex gap-2">
    <a href="<%= base %>/cart" class="btn btn-outline-primary">
      <i class="fa-solid fa-cart-shopping"></i> Cart
      <% if (cartCount) { %>
        <span class="badge text-bg-warning"><%= cartCount %></span>
      <% } %>
    </a>
    <a href="<%= base %>/orders" class="btn btn-outline-success">
      <i class="fa-solid fa-box"></i> My Orders
    </a>
  </div>
</div>

<!-- 🤖 AI Closest Farmer & Smart Logistics Finder -->
<div class="card border-success shadow-sm mb-3" id="closest-farmer-widget" data-base="<%= base %>">
  <div class="card-header bg-success text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <i class="fa-solid fa-route me-1"></i>
      <strong>AI Closest Farmer & Smart Route Finder</strong>
    </div>
    <span class="badge bg-light text-success">Live GPS + Spoilage Risk AI</span>
  </div>

  <div class="card-body">
    <div class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Crop Name (Optional)</label>
        <input type="text" id="cf-crop" class="form-control form-control-sm" value="<%= filters.q || '' %>" placeholder="e.g. Tomato, Wheat, Potato">
      </div>
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Your City (or use Live GPS)</label>
        <select id="cf-city" class="form-select form-select-sm">
          <option value="26.4499,80.3319">Kanpur</option>
          <option value="26.8467,80.9462">Lucknow</option>
          <option value="25.3176,82.9739">Varanasi</option>
          <option value="27.1767,78.0081">Agra</option>
          <option value="25.4358,81.8463">Prayagraj</option>
          <option value="28.5355,77.3910">Noida</option>
        </select>
      </div>
      <div class="col-md-4 d-flex gap-2">
        <button type="button" id="cf-gps-btn" class="btn btn-sm btn-outline-success w-50">
          <i class="fa-solid fa-location-crosshairs"></i> My GPS
        </button>
        <button type="button" id="cf-search-btn" class="btn btn-sm btn-success w-50">
          <i class="fa-solid fa-magnifying-glass-location"></i> Find Closest Farmer
        </button>
      </div>
    </div>

    <div id="cf-status" class="small text-muted mt-2"></div>

    <div id="cf-results-wrap" class="d-none mt-3">
      <div id="cf-winner-banner" class="alert alert-success py-2 mb-3"></div>
      <div id="cf-map" class="rounded border mb-3" style="height: 250px;"></div>

      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Rank</th>
              <th>Farmer & Location</th>
              <th>Crop (Stock)</th>
              <th>Distance & ETA</th>
              <th>Freshness Score</th>
              <th>Landed Rate (Crop + Delivery)</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="cf-tbody"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Search / Filters -->
<form method="GET" action="<%= base %>/dashboard" class="card p-3 mb-3">
  <div class="row g-2">
    <div class="col-lg-5">
      <div class="input-group">
        <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
        <input class="form-control" type="search" name="q" value="<%= filters.q %>"
          placeholder="Search for a crop, location, or farmer/village...">
      </div>
    </div>
    <div class="col-6 col-lg-2">
      <select class="form-select" name="category" onchange="this.form.submit()">
        <option value="">All categories</option>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-6 col-lg-2">
      <input class="form-control" type="number" min="1" name="maxPrice" value="<%= filters.maxPrice %>"
        placeholder="Max ₹/kg">
    </div>
    <div class="col-6 col-lg-2">
      <select class="form-select" name="sort" onchange="this.form.submit()">
        <option value="new" <%= filters.sort === 'new' ? 'selected' : '' %>>New First</option>
        <option value="low" <%= filters.sort === 'low' ? 'selected' : '' %>>Price: Low to High</option>
        <option value="high" <%= filters.sort === 'high' ? 'selected' : '' %>>Price: High to Low</option>
      </select>
    </div>
    <div class="col-6 col-lg-1 d-flex gap-2">
      <button type="submit" class="btn btn-primary flex-grow-1" title="Search">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
    </div>
  </div>

  <% if (hasFilter) { %>
    <div class="mt-2 d-flex justify-content-between align-items-center">
      <span class="small text-muted">
        <%= crops.length %> crop found
      </span>
      <a href="<%= base %>/dashboard" class="small text-decoration-none">
        <i class="fa-solid fa-xmark"></i> Remove filters
      </a>
    </div>
  <% } %>
</form>

<!-- Results -->
<% if (crops.length === 0) { %>
  <div class="card p-5 text-center text-muted">
    No crops found. Try changing the filters.
    <% if (hasFilter) { %>
      <div class="mt-3">
        <a href="<%= base %>/dashboard" class="btn btn-outline-secondary btn-sm">Remove Filters</a>
      </div>
    <% } %>
  </div>
<% } else { %>
  <div class="row g-4">
    <% crops.forEach(crop => { %>
      <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
          <% if (crop.image) { %>
            <img src="<%= crop.image %>" alt="<%= crop.name %>"
              style="height: 180px; object-fit: cover; border-radius: var(--radius-md) var(--radius-md) 0 0;">
          <% } else { %>
            <div class="d-flex align-items-center justify-content-center"
              style="height: 180px; background: var(--background-soft);">
              <i class="fa-solid fa-wheat-awn fa-3x text-success"></i>
            </div>
          <% } %>
          <div class="card-body">
            <div class="d-flex justify-content-between">
              <h5 class="card-title"><%= crop.name %></h5>
              <span class="badge text-bg-success"><%= crop.category %></span>
              <% if (crop.sellerRole === 'bulkbuyer') { %>
                <span class="badge text-bg-dark">Bulk buyer</span>
              <% } %>
              <% if (crop.sellerRole === 'kisan') { %>
                <span class="badge text-bg-dark">Farmer</span>
              <% } %>
            </div>
            <p class="mb-1"><strong>₹<%= crop.price %></strong> / kg</p>
            <p class="mb-1 text-muted small">Available: <%= crop.quantity %> kg</p>
            <p class="mb-1 text-muted small">Min order: <%= crop.minQtyFor('customer') %> kg</p>
            <% if (crop.location) { %>
              <p class="mb-0 text-muted small">
                <i class="fa-solid fa-location-dot"></i> <%= crop.location %>
              </p>
            <% } %>
          </div>
          <div class="card-footer bg-white border-0 pb-3">
            <a href="<%= base %>/crops/<%= crop._id %>" class="btn btn-primary w-100">See & order</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<script>
  (function () {
    const widget = document.getElementById('closest-farmer-widget');
    const baseUrl = widget ? widget.dataset.base : '/buyer';
    let buyerLat = 26.4499, buyerLng = 80.3319;
    let map, layerGroup;

    const citySelect = document.getElementById('cf-city');
    const gpsBtn = document.getElementById('cf-gps-btn');
    const searchBtn = document.getElementById('cf-search-btn');
    const cropInput = document.getElementById('cf-crop');
    const statusEl = document.getElementById('cf-status');
    const wrapEl = document.getElementById('cf-results-wrap');
    const winnerEl = document.getElementById('cf-winner-banner');
    const tbody = document.getElementById('cf-tbody');

    citySelect.addEventListener('change', () => {
      const [lat, lng] = citySelect.value.split(',').map(Number);
      buyerLat = lat;
      buyerLng = lng;
      runClosestSearch();
    });

    gpsBtn.addEventListener('click', () => {
      if (!navigator.geolocation) {
        statusEl.textContent = 'Geolocation is not supported by your browser.';
        return;
      }
      statusEl.textContent = 'Detecting your live GPS coordinates...';
      navigator.geolocation.getCurrentPosition((pos) => {
        buyerLat = pos.coords.latitude;
        buyerLng = pos.coords.longitude;
        statusEl.textContent = '✓ Live GPS locked (' + buyerLat.toFixed(4) + ', ' + buyerLng.toFixed(4) + ')';
        runClosestSearch();
      }, () => {
        statusEl.textContent = 'Location permission denied; using selected city coordinates.';
        runClosestSearch();
      });
    });

    searchBtn.addEventListener('click', runClosestSearch);

    async function runClosestSearch() {
      statusEl.textContent = 'Calculating road distances, freshness score & closest farmer...';
      const params = new URLSearchParams({
        lat: buyerLat,
        lng: buyerLng,
        crop: cropInput.value.trim()
      });

      try {
        const res = await fetch('/kisan/api/closest-farmers?' + params.toString());
        const json = await res.json();
        if (!res.ok || !json.success) {
          statusEl.textContent = 'Could not load closest farmers right now.';
          return;
        }

        const data = json.data;
        if (!data.farmers || !data.farmers.length) {
          statusEl.textContent = 'No matching farmers found with stock.';
          wrapEl.classList.add('d-none');
          return;
        }

        statusEl.textContent = '';
        wrapEl.classList.remove('d-none');

        const best = data.closestFarmer;
        winnerEl.innerHTML =
          '🏆 <strong>Closest Farmer to Buy From:</strong> <strong>' + best.kisanName + '</strong> (' + best.location + ') — ' +
          '<strong>' + best.distanceKm + ' km away</strong> (~' + best.etaMins + ' mins) | ' +
          'Crop: <strong>' + best.cropName + '</strong> | Landed Price: <strong>₹' + best.landedCostKg + '/kg</strong> ' +
          '(₹' + best.basePriceKg + ' crop + ₹' + best.transportCostKg + ' delivery) | Freshness: <strong>' + best.freshnessScore + '%</strong>';

        tbody.innerHTML = '';
        data.farmers.slice(0, 8).forEach((f, idx) => {
          const badgeHtml = f.badge ? '<span class="badge text-bg-success ms-1">' + f.badge + '</span>' : '';
          const tr = document.createElement('tr');
          tr.innerHTML =
            '<td><strong>#' + (idx + 1) + '</strong></td>' +
            '<td><strong>' + f.kisanName + '</strong> ' + badgeHtml + '<div class="small text-muted">' + f.location + '</div></td>' +
            '<td>' + f.cropName + ' <span class="badge text-bg-light border">' + f.availableQtyKg + ' kg</span></td>' +
            '<td><strong>' + f.distanceKm + ' km</strong><div class="small text-muted">~' + f.etaMins + ' mins</div></td>' +
            '<td><span class="badge text-bg-' + (f.freshnessScore >= 85 ? 'success' : 'warning') + '">' + f.freshnessScore + '% Fresh</span></td>' +
            '<td><strong>₹' + f.landedCostKg + '/kg</strong><div class="small text-muted">₹' + f.basePriceKg + ' + ₹' + f.transportCostKg + ' shipping</div></td>' +
            '<td><a href="' + baseUrl + '/crops/' + f.cropId + '" class="btn btn-sm btn-primary">See & order</a></td>';
          tbody.appendChild(tr);
        });

        if (!map) {
          map = L.map('cf-map').setView([buyerLat, buyerLng], 8);
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19, attribution: '&copy; OpenStreetMap'
          }).addTo(map);
          layerGroup = L.layerGroup().addTo(map);
        }
        layerGroup.clearLayers();
        map.setView([buyerLat, buyerLng], 8);

        L.circleMarker([buyerLat, buyerLng], { radius: 8, color: '#1d4ed8', fillColor: '#3b82f6', fillOpacity: 0.9 })
          .bindPopup('<strong>Your Location (Buyer)</strong>')
          .addTo(layerGroup);

        data.farmers.slice(0, 6).forEach((f, idx) => {
          const isClosest = idx === 0;
          L.marker([f.lat, f.lng])
            .bindPopup('<strong>#' + (idx + 1) + ' ' + f.kisanName + '</strong> (' + f.cropName + ')<br>' + f.distanceKm + ' km | ₹' + f.landedCostKg + '/kg')
            .addTo(layerGroup);

          L.polyline([[buyerLat, buyerLng], [f.lat, f.lng]], {
            color: isClosest ? '#16a34a' : '#9ca3af',
            weight: isClosest ? 4 : 2,
            dashArray: isClosest ? null : '5, 5'
          }).addTo(layerGroup);
        });

        setTimeout(() => map.invalidateSize(), 100);
      } catch (err) {
        statusEl.textContent = 'Error connecting to Closest Farmer AI service.';
      }
    }
  })();
</script>