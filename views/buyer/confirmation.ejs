<% layout('/layouts/boilerplate') %>

  <% const receiptNo='UK-' + order._id.toString().slice(-8).toUpperCase(); %>
    <% const rate=(order.totalPrice / order.quantity).toFixed(2); %>

      <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
        <a href="<%= base %>/orders" class="text-decoration-none">
          <i class="fa-solid fa-arrow-left"></i> Mere orders
        </a>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
          <i class="fa-solid fa-print"></i> Print / Save PDF
        </button>
      </div>

      <div class="card p-4 mx-auto" style="max-width: 760px;">

        <!-- Header -->
        <div class="text-center mb-3">
          <i class="fa-solid fa-circle-check fa-3x text-success"></i>
          <h3 class="mt-2 mb-1">Order placed</h3>
          <div class="text-muted">Wait for the farmer to confirm the order.</div>
        </div>

        <div class="d-flex justify-content-between flex-wrap gap-2 border rounded p-2 mb-3 bg-light">
          <div><span class="text-muted small">Receipt No.</span><br><strong>
              <%= receiptNo %>
            </strong></div>
          <div><span class="text-muted small">Order date</span><br><strong>
              <%= order.createdAt.toLocaleString('en-IN') %>
            </strong></div>
          <div><span class="text-muted small">Status</span><br><%- include('../partials/statusBadge', { status:
              order.status }) %></div>
        </div>

        <!-- Order items -->
        <h6 class="text-muted">Order details</h6>
        <table class="table table-sm mb-3">
          <thead>
            <tr>
              <th>Crop</th>
              <th class="text-end">Price</th>
              <th class="text-end">Quantity</th>
              <th class="text-end">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <%= order.crop ? order.crop.name : 'Crop Removed' %>
                  <span class="badge text-bg-secondary">
                    <%= order.orderType %>
                  </span>
              </td>
              <td class="text-end">₹<%= rate %> / kg</td>
              <td class="text-end">
                <%= order.quantity %> kg
              </td>
              <td class="text-end">₹<%= order.totalPrice %>
              </td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <th colspan="3" class="text-end">Total payable</th>
              <th class="text-end text-success fs-5">₹<%= order.totalPrice %>
              </th>
            </tr>
          </tfoot>
        </table>

        <div class="row g-3 mb-3">
          <!-- Delivery -->
          <div class="col-md-6">
            <h6 class="text-muted">Delivery details</h6>
            <div class="border rounded p-3 h-100">
              <div><strong>
                  <%= order.buyer.name %>
                </strong></div>
              <% if (order.buyer.businessName) { %>
                <div class="small">
                  <%= order.buyer.businessName %>
                </div>
                <% } %>
                  <div class="small"><i class="fa-solid fa-phone"></i>
                    <%= order.buyer.phone %>
                  </div>
                  <hr class="my-2">
                  <div><i class="fa-solid fa-location-dot"></i> <strong>
                      <%= order.deliveryCity %>
                    </strong></div>
                  <div class="small">
                    <%= order.deliveryAddress %>
                  </div>
                  <% if (order.distanceKm !=null) { %>
                    <div class="small text-muted mt-1">
                      <i class="fa-solid fa-truck"></i>Approximately from the farmer's location <strong>
                        <%= order.distanceKm %> km
                      </strong>
                    </div>
                    <% } %>
            </div>
          </div>

          <!-- Kisan -->
          <div class="col-md-6">
            <h6 class="text-muted">farmer (seller)</h6>
            <div class="border rounded p-3 h-100">
              <% if (order.kisan) { %>
                <div><strong>
                    <%= order.kisan.name %>
                  </strong></div>
                <% if (order.kisan.village) { %>
                  <div class="small">Gaon: <%= order.kisan.village %>
                  </div>
                  <% } %>
                    <% if (order.kisan.fpoName) { %>
                      <div class="small">FPO: <%= order.kisan.fpoName %>
                      </div>
                      <% } %>
                        <div class="small"><i class="fa-solid fa-phone"></i>
                          <%= order.kisan.phone %>
                        </div>
                        <% } else { %>
                          <div class="text-muted">-</div>
                          <% } %>
            </div>
          </div>
        </div>


        <!-- Payment -->
        <h6 class="text-muted">Payment</h6>
        <% const borderCls={ paid: 'border-success' , failed: 'border-danger' , submitted: 'border-info' ,
          pending: 'border-warning' }[order.paymentStatus] || 'border-secondary' ; %>
          <div class="border border-2 rounded p-3 mb-3 <%= borderCls %>">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <% if (order.paymentMethod==='online' ) { %>
                  <div><i class="fa-solid fa-building-columns"></i> <strong>Online (UPI / Bank transfer)</strong></div>
                  <div class="small">UTR: <strong>
                      <%= order.transactionId %>
                    </strong></div>
                  <% if (order.paymentProof) { %>
                    <a class="small" href="<%= order.paymentProof %>" target="_blank">Screenshot dekho</a>
                    <% } %>
                      <% } else { %>
                        <div><i class="fa-solid fa-money-bill-wave"></i> <strong>Cash on Delivery (COD)</strong></div>
                        <% } %>
                          <div class="small text-muted">Amount: ₹<%= order.totalPrice %>
                          </div>
              </div>
              <div class="text-end">
                <%- include('../partials/paymentBadge', { paymentMethod: order.paymentMethod, paymentStatus:
                  order.paymentStatus }) %>
                  <% if (order.paymentStatus==='paid' && order.paidAt) { %>
                    <div class="small text-muted">
                      <%= order.paidAt.toLocaleString('en-IN') %>
                    </div>
                    <% } %>
              </div>
            </div>

            <% if (order.paymentMethod==='cod' && order.paymentStatus==='pending' ) { %>
              <div class="small mt-2">
                Delivery ke time kisan ko <strong>₹<%= order.totalPrice %></strong> cash dein.
                Order "Delivered" hote hi status "Paid" ho jayega.
              </div>
              <% } else if (order.paymentStatus==='submitted' ) { %>
                <div class="small mt-2">Kisan aapka payment verify kar raha hai. Verify hone ke baad hi order ship hoga.
                </div>
                <% } else if (order.paymentStatus==='failed' ) { %>
                  <div class="alert alert-danger py-2 mt-2 mb-2 small">
                    Kisan ne payment proof reject kar diya. Sahi UTR aur screenshot dobara bhejo.
                  </div>
                  <% if (base==='/buyer' ) { %>
                    <form action="<%= base %>/orders/<%= order._id %>/payment" method="POST"
                      enctype="multipart/form-data" class="d-print-none">
                      <input class="form-control mb-2" name="transactionId" maxlength="30"
                        placeholder="Sahi UTR / Transaction ID" required>
                      <input class="form-control mb-2" type="file" name="image"
                        accept="image/jpeg,image/png,image/webp">
                      <button class="btn btn-warning btn-sm">Proof dobara bhejo</button>
                    </form>
                    <% } %>
                      <% } %>
          </div>

          <% if (order.trackingId) { %>
            <div class="small text-muted mb-2">Tracking ID: <strong>
                <%= order.trackingId %>
              </strong></div>
            <% } %>

              <div class="d-flex gap-2 d-print-none">
                <a href="<%= base %>/orders" class="btn btn-primary flex-grow-1">Mere orders dekho</a>
                <a href="<%= base %>/dashboard" class="btn btn-outline-success flex-grow-1">Aur crops dekho</a>
              </div>
      </div>