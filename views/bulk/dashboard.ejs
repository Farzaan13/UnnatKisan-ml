<% layout('/layouts/boilerplate') %>

  <% const hasFilter=filters.q || filters.category || filters.maxPrice || filters.need || filters.sort !=='new' ; %>

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h3 class="mb-0">Bulk Marketplace 🚚</h3>
        <small class="text-muted">Purchase directly from farmer/ FPOOs</small>
      </div>
      <div class="d-flex gap-2">
        <a href="<%= base %>/cart" class="btn btn-outline-primary">
          <i class="fa-solid fa-cart-shopping"></i> Cart
          <% if (cartCount) { %><span class="badge text-bg-warning">
              <%= cartCount %>
            </span>
            <% } %>
        </a>
        <a href="<%= base %>/orders" class="btn btn-outline-success">
          <i class="fa-solid fa-box"></i> my orders
        </a>
      </div>
    </div>

    <!-- Summary -->
    <div class="row g-3 mb-3">
      <div class="col-6 col-md-3">
        <div class="card p-3 text-center">
          <div class="text-muted small">Available crops</div>
          <div class="fs-4 fw-bold">
            <%= crops.length %>
          </div>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="card p-3 text-center">
          <div class="text-muted small">Total stock</div>
          <div class="fs-4 fw-bold">
            <%= crops.reduce((s, c)=> s + c.quantity, 0) %> kg
          </div>
        </div>
      </div>
      <div class="col-12 col-md-6">
        <div class="alert alert-info mb-0 h-100 d-flex align-items-center">
          Only crops with stock available for bulk purchase will be displayed.
        </div>
      </div>
    </div>

    <!-- Search / Filters -->
    <form method="GET" action="<%= base %>/dashboard" class="card p-3 mb-3">
      <div class="row g-2">
        <div class="col-lg-4">
          <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input class="form-control" type="search" name="q" value="<%= filters.q %>"
              placeholder="Crop, location ya kisan / gaon dhundo...">
          </div>
        </div>
        <div class="col-6 col-lg-2">
          <input class="form-control" type="number" min="1" name="need" value="<%= filters.need %>"
            placeholder="Mujhe chahiye (kg)">
        </div>
        <div class="col-6 col-lg-2">
          <select class="form-select" name="category" onchange="this.form.submit()">
            <option value="">Sab category</option>
            <% categories.forEach(c=> { %>
              <option value="<%= c %>" <%=filters.category===c ? 'selected' : '' %>><%= c %>
              </option>
              <% }) %>
          </select>
        </div>
        <div class="col-6 col-lg-1">
          <input class="form-control" type="number" min="1" name="maxPrice" value="<%= filters.maxPrice %>"
            placeholder="Max ₹/kg">
        </div>
        <div class="col-6 col-lg-2">
          <select class="form-select" name="sort" onchange="this.form.submit()">
            <option value="new" <%=filters.sort==='new' ? 'selected' : '' %>>Naya pehle</option>
            <option value="low" <%=filters.sort==='low' ? 'selected' : '' %>>Price: kam se zyada</option>
            <option value="high" <%=filters.sort==='high' ? 'selected' : '' %>>Price: zyada se kam</option>
          </select>
        </div>
        <div class="col-12 col-lg-1 d-flex gap-2">
          <button type="submit" class="btn btn-primary flex-grow-1" title="Search">
            <i class="fa-solid fa-magnifying-glass"></i>
          </button>
        </div>
      </div>

      <% if (hasFilter) { %>
        <div class="mt-2 d-flex justify-content-between align-items-center">
          <span class="small text-muted">
            <%= crops.length %> crop found
          </span>
          <a href="<%= base %>/dashboard" class="small text-decoration-none">
            <i class="fa-solid fa-xmark"></i> Filter remove
          </a>
        </div>
        <% } %>
    </form>

    <!-- Results -->
    <% if (crops.length===0) { %>
      <div class="card p-5 text-center text-muted">
      not any crop found
        <div class="small mt-2">
         The bulk dashboard displays only those crops for which the stock is not less than the minimum bulk quantity.
          <% if (filters.need) { %>
            Aapne <strong>
              <%= filters.need %> kg
            </strong> It has been requested; try adjusting the amount—increase or decrease it.
            <% } %>
        </div>
        <% if (hasFilter) { %>
          <div class="mt-3">
            <a href="<%= base %>/dashboard" class="btn btn-outline-secondary btn-sm">Filter remove</a>
          </div>
          <% } %>
      </div>
      <% } else { %>
        <div class="card">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Crop</th>
                  <th>Category</th>
                  <th>Rate</th>
                  <th>Available</th>
                  <th>Min. order</th>
                  <th>Min. order price</th>
                  <th>Location</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% crops.forEach(crop=> { %>
                  <tr>
                    <td>
                      <div class="d-flex align-items-center gap-2">
                        <% if (crop.image) { %>
                          <img src="<%= crop.image %>" alt="<%= crop.name %>"
                            style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px;">
                          <% } else { %>
                            <div class="d-flex align-items-center justify-content-center"
                              style="width: 48px; height: 48px; border-radius: 8px; background: var(--background-soft);">
                              <i class="fa-solid fa-wheat-awn text-success"></i>
                            </div>
                            <% } %>
                              <strong>
                                <%= crop.name %>
                              </strong>
                      </div>
                    </td>
                    <td><span class="badge text-bg-success">
                        <%= crop.category %>
                      </span></td>
                    <td>₹<%= crop.priceFor('bulkbuyer') %> / kg</td>
                    <td>
                      <%= crop.quantity %> kg
                    </td>
                    <td>
                      <%= crop.minBulkQty %> kg
                    </td>
                    <td>₹<%= (crop.minBulkQty * crop.priceFor('bulkbuyer')).toLocaleString('en-IN') %>
                    </td>
                    <td class="text-muted small">
                      <%= crop.location || '-' %>
                    </td>
                    <td class="text-end">
                      <a href="<%= base %>/crops/<%= crop._id %>" class="btn btn-primary btn-sm">Bulk order</a>
                    </td>
                  </tr>
                  <% }) %>
              </tbody>
            </table>
          </div>
        </div>
        <% } %>