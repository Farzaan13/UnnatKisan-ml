<% layout('/layouts/boilerplate') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h3 class="mb-0">Delivery management 🚚</h3>
    <small class="text-muted">
      <% if (dKind === 'admin') { %>
        You manage the delivery of orders between farmers and customers.
      <% } else { %>
       You manage the delivery of orders between the farmer and the customer.
      <% } %>
    </small>
  </div>
</div>

<!-- ================= PARTNERS ================= -->
<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center bg-white">
    <strong>Delivery partners (<%= partners.length %>)</strong>
    <button class="btn btn-sm btn-success" type="button" data-bs-toggle="collapse" data-bs-target="#addPartner">
      <i class="fa-solid fa-plus"></i> New partner
    </button>
  </div>

  <div class="collapse" id="addPartner">
    <form action="<%= dBase %>/partners" method="POST" class="row g-2 p-3 border-bottom">
      <div class="col-md-3"><input name="name" class="form-control" placeholder="Name" maxlength="60" required></div>
      <div class="col-md-3"><input name="email" type="email" class="form-control" placeholder="Email " required></div>
      <div class="col-md-2"><input name="phone" class="form-control" placeholder="10 digit phone" maxlength="10" required></div>
      <div class="col-md-2"><input name="vehicle" class="form-control" placeholder=" (bike, tempo...)" maxlength="40"></div>
      <div class="col-md-2"><input name="password" type="password" class="form-control" placeholder="Password (8+)" minlength="8" required></div>
      <div class="col-12"><button class="btn btn-success">Create Partner </button></div>
    </form>
  </div>

  <% if (partners.length === 0) { %>
    <div class="p-4 text-center text-muted">There are no delivery partners yet. First, add a partner.</div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Vehicle</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% partners.forEach(p => { %>
            <tr>
              <td><%= p.name %></td>
              <td><%= p.email %></td>
              <td><%= p.phone %></td>
              <td><%= p.vehicle || '-' %></td>
              <td>
                <% if (p.isBlocked) { %><span class="badge text-bg-danger">Band</span>
                <% } else { %><span class="badge text-bg-success">Active</span><% } %>
              </td>
              <td>
                <form action="<%= dBase %>/partners/<%= p._id %>/toggle?_method=PATCH" method="POST" class="d-inline">
                  <button class="btn btn-sm btn-outline-secondary"><%= p.isBlocked ? 'Activate' : 'Deactivate' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- ================= ORDERS ================= -->
<ul class="nav nav-pills mb-3">
  <% [['accepted', 'Assign karna hai'], ['shipped', 'Raste mein'], ['delivered', 'Delivered']].forEach(([s, label]) => { %>
    <li class="nav-item">
      <a class="nav-link <%= status === s ? 'active' : '' %>" href="<%= dBase %>?status=<%= s %>"><%= label %></a>
    </li>
  <% }) %>
</ul>

<% if (orders.length === 0) { %>
  <div class="card p-5 text-center text-muted">There are no orders in this tab.</div>
<% } else { %>
  <div class="card">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Order</th>
            <th>Pickup (seller)</th>
            <th>Drop (buyer)</th>
            <th>Payment</th>
            <th style="min-width: 240px;">Delivery partner</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td>
                <strong><%= o.crop ? o.crop.name : 'Crop removed' %></strong> · <%= o.quantity %> kg
                <br><small class="text-muted"><%= o.trackingId || '-' %></small>
                <br><span class="badge text-bg-<%= o.orderType === 'bulk' ? 'dark' : 'secondary' %>"><%= o.orderType %></span>
              </td>
              <td>
                <%= o.kisan ? o.kisan.name : '-' %>
                <% if (o.kisan && o.kisan.businessName) { %><br><small class="text-muted"><%= o.kisan.businessName %></small><% } %>
                <% if (o.kisan && o.kisan.village) { %><br><small class="text-muted"><%= o.kisan.village %></small><% } %>
                <% if (o.crop && o.crop.location) { %><br><small class="text-muted"><i class="fa-solid fa-location-dot"></i> <%= o.crop.location %></small><% } %>
                <% if (o.kisan) { %><br><small class="text-muted"><i class="fa-solid fa-phone"></i> <%= o.kisan.phone %></small><% } %>
              </td>
              <td>
                <%= o.buyer ? o.buyer.name : '-' %>
                <% if (o.buyer) { %><br><small class="text-muted"><i class="fa-solid fa-phone"></i> <%= o.buyer.phone %></small><% } %>
                <br><small><%= o.deliveryAddress || '' %></small>
                <br><small class="text-muted"><%= o.deliveryCity || '-' %><% if (o.distanceKm != null) { %> · ~<%= o.distanceKm %> km<% } %></small>
              </td>
              <td>
                <%= o.paymentMethod === 'cod' ? 'COD' : 'Online' %>
                <br><small class="text-muted"><%= o.paymentStatus %></small>
                <% if (status === 'accepted' && o.paymentMethod === 'online' && o.paymentStatus !== 'paid') { %>
                  <br><small class="text-danger">Pickup will not take place until the payment is verified.</small>
                <% } %>
              </td>
                          <td>
                <% if (status === 'accepted') { %>
                  <form action="<%= dBase %>/orders/<%= o._id %>/assign?_method=PATCH" method="POST" class="d-flex gap-1">
                    <select name="partner" class="form-select form-select-sm" required>
                      <option value="">Choose partner</option>
                      <% partners.filter(p => !p.isBlocked).forEach(p => { %>
                        <option value="<%= p._id %>"
                          <%= o.deliveryPartner && o.deliveryPartner._id.equals(p._id) ? 'selected' : '' %>>
                          <%= p.name %>
                        </option>
                      <% }) %>
                    </select>
                    <button class="btn btn-sm btn-primary"><%= o.deliveryPartner ? 'Change' : 'Assign' %></button>
                  </form>

                <% } else if (o.deliveryPartner) { %>
                  🚚 <%= o.deliveryPartner.name %><br>
                  <small class="text-muted"><i class="fa-solid fa-phone"></i> <%= o.deliveryPartner.phone %></small>

                  <% if (status === 'shipped') { %>
                    <br><a href="/track/<%= o._id %>" class="small"><i class="fa-solid fa-location-dot"></i> Track live</a>
                  <% } %>

                  <% if (o.deliveryIssue && o.deliveryIssue.reason) { %>
                    <div class="text-danger small mt-1">
                      ⚠ Failed: <%= o.deliveryIssue.reason %><%= o.deliveryIssue.note ? ' (' + o.deliveryIssue.note + ')' : '' %>
                    </div>
                    <form action="<%= dBase %>/orders/<%= o._id %>/assign?_method=PATCH" method="POST" class="d-flex gap-1 mt-1">
                      <select name="partner" class="form-select form-select-sm" required>
                        <option value="">Reassign to...</option>
                        <% partners.filter(p => !p.isBlocked).forEach(p => { %>
                          <option value="<%= p._id %>"><%= p.name %></option>
                        <% }) %>
                      </select>
                      <button class="btn btn-sm btn-outline-primary">Reassign</button>
                    </form>
                  <% } %>
                <% } else { %>
                  <span class="text-muted">-</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>