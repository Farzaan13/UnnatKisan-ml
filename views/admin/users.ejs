<% layout('/layouts/boilerplate') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Manage users</h3>
  <a href="/admin/dashboard" class="btn btn-outline-success">Dashboard</a>
</div>

<!-- Filter + search -->
<form method="GET" action="/admin/users" class="row g-2 mb-3">
  <div class="col-md-3">
    <select name="role" class="form-select">
      <option value="">All roles</option>
      <option value="kisan" <%= role === 'kisan' ? 'selected' : '' %>>Kisan</option>
      <option value="bulkbuyer" <%= role === 'bulkbuyer' ? 'selected' : '' %>>Bulk buyer</option>
      <option value="customer" <%= role === 'customer' ? 'selected' : '' %>>Customer</option>
    </select>
  </div>
  <div class="col-md-6">
    <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Search by name, email or phone">
  </div>
  <div class="col-md-3 d-flex gap-2">
    <button class="btn btn-primary">Search</button>
    <a href="/admin/users" class="btn btn-outline-secondary">Reset</a>
  </div>
</form>

<% if (users.length === 0) { %>
  <div class="card p-5 text-center text-muted">No users found.</div>
<% } else { %>
  <div class="card">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead>
          <tr>
            <th>Name</th>
            <th>Role</th>
            <th>Contact</th>
            <th>Details</th>
            <th>Status</th>
            <th style="min-width: 260px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td>
                <strong><%= u.name %></strong>
                <br><small class="text-muted">Joined <%= u.createdAt.toLocaleDateString('en-IN') %></small>
              </td>
              <td><span class="badge text-bg-secondary"><%= u.role %></span></td>
              <td>
                <%= u.email %><br>
                <small class="text-muted"><i class="fa-solid fa-phone"></i> <%= u.phone %></small>
              </td>
              <td class="small">
                <% if (u.role === 'kisan') { %>
                  Village: <%= u.village || '-' %><br>
                  <% if (u.fpoName) { %>FPO: <%= u.fpoName %><% } %>
                <% } else if (u.role === 'bulkbuyer') { %>
                  <%= u.businessName || '-' %><br>
                  GST: <%= u.gstNumber || '-' %>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td>
                <% if (u.isBlocked) { %>
                  <span class="badge text-bg-danger">Blocked</span>
                  <% if (u.blockReason) { %><br><small class="text-muted"><%= u.blockReason %></small><% } %>
                <% } else { %>
                  <span class="badge text-bg-success">Active</span>
                <% } %>
              </td>
              <td>
                <% if (u.isBlocked) { %>
                  <form action="/admin/users/<%= u._id %>/unblock?_method=PATCH" method="POST" class="d-inline">
                    <button class="btn btn-sm btn-success">Unblock</button>
                  </form>
                <% } else { %>
                  <form action="/admin/users/<%= u._id %>/block?_method=PATCH" method="POST" class="d-flex gap-1"
                    onsubmit="return confirm('Is user ko block karein?');">
                    <input type="text" name="reason" class="form-control form-control-sm"
                      placeholder="Reason" maxlength="200" required>
                    <button class="btn btn-sm btn-danger">Block</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>