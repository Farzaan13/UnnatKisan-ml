<% layout('/layouts/boilerplate') %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">Namaste, <%= currentUser.name %> 🌾</h3>
    <a href="/kisan/crops/new" class="btn btn-primary">
      <i class="fa-solid fa-plus"></i> Add Crop
    </a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card p-3 text-center">
        <div class="fs-3 fw-semibold text-success">
          <%= crops.length %>
        </div>
        <small class="text-muted">Total crops</small>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card p-3 text-center">
        <div class="fs-3 fw-semibold text-success">
          <%= totalQty %> kg
        </div>
        <small class="text-muted">Total stock</small>
      </div>
    </div>
  </div>

  <% if (crops.length===0) { %>
    <div class="card p-5 text-center">
      <p class="text-muted mb-3">You haven't added any crops yet.</p>
      <div><a href="/kisan/crops/new" class="btn btn-primary">Add your first crop</a></div>
    </div>
    <% } else { %>
      <div class="row g-4">
        <% crops.forEach(crop=> { %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100">
              <% if (crop.image) { %>
                <img src="<%= crop.image %>" class="card-img-top" alt="<%= crop.name %>"
                  style="height: 180px; object-fit: cover; border-radius: var(--radius-md) var(--radius-md) 0 0;">
                <% } else { %>
                  <div class="d-flex align-items-center justify-content-center"
                    style="height: 180px; background: var(--background-soft);">
                    <i class="fa-solid fa-wheat-awn fa-3x text-success"></i>
                  </div>
                  <% } %>

                    <div class="card-body">
                      <div class="d-flex justify-content-between">
                        <h5 class="card-title">
                          <%= crop.name %>
                        </h5>
                        <span class="badge text-bg-success">
                          <%= crop.category %>
                        </span>
                      </div>
                      <p class="mb-2">
                        <%- include('../partials/verifyBadge', { verified: crop.verified }) %>
                          <% if (crop.verified==='pending' ) { %>
                            <small class="text-muted">Waiting for admin approval</small>
                            <% } else if (crop.verified==='rejected' && crop.verifyNote) { %>
                              <small class="text-danger">Reason: <%= crop.verifyNote %></small>
                              <% } %>
                      </p>
                      <p class="mb-1"><strong>₹<%= crop.price %></strong> / kg <span
                          class="small text-muted">(customer)</span></p>
                      <p class="mb-1"><strong>₹<%= crop.priceFor('bulkbuyer') %></strong> / kg
                        <span class="small text-muted">(bulk, min <%= crop.minBulkQty %> kg)</span>
                      </p>
                      <p class="mb-1 text-muted small">Stock: <%= crop.quantity %> kg</p>
                      <% if (crop.location) { %>
                        <p class="mb-0 text-muted small"><i class="fa-solid fa-location-dot"></i>
                          <%= crop.location %>
                        </p>
                        <% } %>
                    </div>

                    <div class="card-footer bg-white d-flex gap-2 border-0 pb-3">
                      <a href="/kisan/crops/<%= crop._id %>/edit" class="btn btn-sm btn-outline-success">
                        <i class="fa-solid fa-pen"></i> Edit
                      </a>
                      <form action="/kisan/crops/<%= crop._id %>?_method=DELETE" method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this crop?');">
                        <button class="btn btn-sm btn-outline-danger">
                          <i class="fa-solid fa-trash"></i> Delete
                        </button>
                      </form>
                    </div>
            </div>
          </div>
          <% }) %>
      </div>
      <% } %>