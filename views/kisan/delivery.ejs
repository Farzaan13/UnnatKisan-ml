<% layout('/layouts/boilerplate') %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0"><i class="fa-solid fa-route text-success"></i> Delivery plan</h3>
  <a href="/kisan/orders" class="btn btn-outline-success">Orders</a>
</div>

<form method="GET" action="/kisan/delivery-plan" class="card p-3 mb-4">
  <div class="row g-2 align-items-end">
    <div class="col-md-4">
      <label class="form-label" for="pickup">Pickup city (your village/mandi where you are)</label>
      <select class="form-select" id="pickup" name="pickup">
        <% cities.forEach(c => { %>
          <option value="<%= c %>" <%= c === pickup ? 'selected' : '' %>><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2"><button class="btn btn-primary w-100">Route </button></div>
  </div>
</form>

<% if (orderCount === 0) { %>
  <div class="card p-5 text-center text-muted">
    No accepted orders available. Please <a href="/kisan/orders">accept some orders</a> first.
  </div>
<% } else { %>
  <% if (plan.skipped > 0) { %>
    <div class="alert alert-warning py-2"><%= plan.skipped %> order(s) do not have a delivery city specified and will not be included in the route.</div>
  <% } %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card p-3 text-center">
      <div class="fs-3 fw-semibold text-success"><%= plan.totalKm %> km</div><small class="text-muted">Optimized route</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card p-3 text-center">
      <div class="fs-3 fw-semibold"><%= plan.naiveKm %> km</div><small class="text-muted">Unoptimized route</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card p-3 text-center">
      <div class="fs-3 fw-semibold text-success"><%= plan.savedKm %> km (<%= plan.savedPct %>%)</div><small class="text-muted">Savings</small>
    </div></div>
    <div class="col-6 col-md-3"><div class="card p-3 text-center">
      <div class="fs-3 fw-semibold text-success">₹<%= plan.cost %></div>
      <small class="text-muted">Estimated cost (₹<%= plan.costPerKm %>/km, previously ₹<%= plan.naiveCost %>)</small>
    </div></div>
  </div>

  <div class="card">
    <div class="card-header bg-white fw-semibold">
      <i class="fa-solid fa-truck"></i> Pickup: <%= pickup %>
    </div>
    <ul class="list-group list-group-flush">
      <% plan.stops.forEach((s, i) => { %>
        <li class="list-group-item">
          <div class="d-flex justify-content-between">
            <strong>Stop <%= i + 1 %>: <%= s.city %></strong>
            <span class="text-muted"><%= s.legKm %> km (total <%= s.cumKm %> km)</span>
          </div>
          <% s.orders.forEach(o => { %>
            <div class="small text-muted">
              <%= o.crop ? o.crop.name : 'Crop' %> × <%= o.quantity %> kg
              → <%= o.buyer ? o.buyer.name : '-' %>
              <% if (o.buyer) { %>(<%= o.buyer.phone %>)<% } %>
              <% if (o.trackingId) { %>| <%= o.trackingId %><% } %>
              <br><i class="fa-solid fa-location-dot"></i> <%= o.deliveryAddress %>
            </div>
          <% }) %>
        </li>
      <% }) %>
    </ul>
  </div>
  <p class="text-muted small mt-2">
    The distance is calculated by multiplying the straight-line distance by 1.3, and the return trip is not included.
  </p>
<% } %>

<!-- Paste inside views/kisan/delivery.ejs -->
<% if (typeof mlRoute !== 'undefined' && mlRoute && mlRoute.orderedStops && mlRoute.orderedStops.length > 0) { %>
  <div class="card border-success shadow-sm mb-4">
    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <i class="fa-solid fa-truck-fast me-1"></i>
        <strong>AI Perishability-Aware Multi-Stop Route Optimization (Start: <%= mlRoute.pickupCity %>)</strong>
      </div>
      <span class="badge bg-light text-success">
        Saved <%= mlRoute.kmSaved %> km (<%= mlRoute.fuelSavedLiters %> L fuel)
      </span>
    </div>

    <div class="card-body">
      <div class="row g-3 mb-3">
        <div class="col-md-3 col-6">
          <div class="p-2 border rounded bg-light">
            <div class="small text-muted">Optimized Total Distance</div>
            <div class="fs-5 fw-bold text-success"><%= mlRoute.totalKm %> km</div>
            <div class="small text-muted">Unoptimized: <%= mlRoute.naiveKm %> km</div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="p-2 border rounded bg-light">
            <div class="small text-muted">Distance & Fuel Saved</div>
            <div class="fs-5 fw-bold text-primary"><%= mlRoute.kmSaved %> km</div>
            <div class="small text-muted">~<%= mlRoute.fuelSavedLiters %> Liters Diesel Saved</div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="p-2 border rounded bg-light">
            <div class="small text-muted">Est. Logistics Cost</div>
            <div class="fs-5 fw-bold text-dark">₹<%= mlRoute.estimatedCostRs %></div>
            <div class="small text-muted">@ ₹14/km pooled truck rate</div>
          </div>
        </div>
        <div class="col-md-3 col-6">
          <div class="p-2 border rounded bg-light">
            <div class="small text-muted">Pooled Stops</div>
            <div class="fs-5 fw-bold text-dark"><%= mlRoute.orderedStops.length %> Drops</div>
            <div class="small text-muted">Sorted by perishability & distance</div>
          </div>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Stop #</th>
              <th>Buyer & Destination</th>
              <th>Crop & Load</th>
              <th>Priority Reason</th>
              <th>Leg Distance</th>
              <th>Cumulative ETA</th>
              <th>Transit Spoilage Risk</th>
            </tr>
          </thead>
          <tbody>
            <% mlRoute.orderedStops.forEach(s => { %>
              <tr>
                <td><span class="badge text-bg-success">Stop <%= s.stopNumber %></span></td>
                <td><strong><%= s.buyerName %></strong> <span class="text-muted small">(<%= s.city %>)</span></td>
                <td><%= s.cropName %> (<%= s.quantityKg %> kg)</td>
                <td><span class="badge text-bg-light border text-dark"><%= s.priorityBadge %></span></td>
                <td>+<%= s.legKm %> km <span class="text-muted small">(Total: <%= s.cumulativeKm %> km)</span></td>
                <td>~<%= s.etaMins %> mins</td>
                <td>
                  <span class="badge text-bg-<%= s.spoilageRiskPct < 20 ? 'success' : 'warning' %>">
                    <%= s.spoilageRiskPct %>% Risk
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>